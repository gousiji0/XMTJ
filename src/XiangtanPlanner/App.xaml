<Application x:Class="XiangtanPlanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XiangtanPlanner"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#16233C</Color>
            <Color x:Key="AccentColor">#5BD4FF</Color>
            <Color x:Key="PanelColor">#1D2B45</Color>
            <Color x:Key="PanelSecondaryColor">#253654</Color>
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelSecondaryBrush" Color="{StaticResource PanelSecondaryColor}" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
